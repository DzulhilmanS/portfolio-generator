# Telegram Bot Configuration
# 1. Go to @BotFather on Telegram
# 2. Create a new bot with /newbot
# 3. Copy the token here
# 4. Add the bot as an ADMIN to your @MyBrokerBuycalls channel
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Your Telegram channel username (without @)
TELEGRAM_CHANNEL_USERNAME=MyBrokerBuycalls

# Optional: override default channel ID if known
# TELEGRAM_CHANNEL_ID=-100xxxxxxxxxx

# App config
NEXT_PUBLIC_APP_NAME=Portfolio Generator
NEXT_PUBLIC_CURRENCY=RM
